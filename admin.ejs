<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản trị Hoạt động Tình nguyện - Trường KT&CN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🎓 TRANG QUẢN TRỊ ĐOÀN - HỘI / KHOA / CLB</a>
            <div>
                <a href="/" class="btn btn-outline-light btn-sm me-2">Xem trang chủ</a>
                <a href="/logout" class="btn btn-danger btn-sm">Đăng xuất</a>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white fw-bold">+ Công bố hoạt động tình nguyện mới</div>
            <div class="card-body">
                <form method="POST" action="/admin/hoat-dong/them" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Tên hoạt động *</label>
                        <input type="text" name="tieu_de" class="form-control" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Đơn vị tổ chức *</label>
                        <select name="don_vi_id" class="form-select">
                            <% donVis.forEach(dv => { %>
                                <option value="<%= dv.id %>"><%= dv.ten_don_vi %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Số lượng tối đa *</label>
                        <input type="number" name="so_luong_toi_da" class="form-control" value="30" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Thời gian bắt đầu *</label>
                        <input type="datetime-local" name="thoi_gian_bat_dau" class="form-control" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Địa điểm tổ chức *</label>
                        <input type="text" name="dia_diem" class="form-control" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Yêu cầu sinh viên</label>
                        <input type="text" name="yeu_cau" class="form-control" placeholder="VD: Áo Đoàn, giày bata...">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Mô tả chi tiết nội dung</label>
                        <textarea name="mo_ta" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary fw-bold">Đăng tải hoạt động</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-secondary text-white fw-bold">Danh sách hoạt động đang quản lý</div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Tên hoạt động</th>
                            <th>Đơn vị</th>
                            <th>Thời gian</th>
                            <th>Đã đăng ký</th>
                            <th>Xóa</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% hoatDongs.forEach(hd => { %>
                            <tr>
                                <td class="fw-bold"><%= hd.tieu_de %></td>
                                <td><%= hd.ten_don_vi %></td>
                                <td class="small"><%= new Date(hd.thoi_gian_bat_dau).toLocaleString('vi-VN') %></td>
                                <td><span class="badge bg-info text-dark"><%= hd.da_dang_ky %> / <%= hd.so_luong_toi_da %></span></td>
                                <td>
                                    <form method="POST" action="/admin/hoat-dong/xoa/<%= hd.id %>" onsubmit="return confirm('Xóa hoạt động này?');">
                                        <button class="btn btn-danger btn-sm">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">Quản lý Sinh viên đăng ký & Ghi nhận kết quả</span>
                <a href="/admin/xuat-excel" class="btn btn-light btn-sm fw-bold text-success">📥 Xuất danh sách Excel (.CSV)</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>MSSV - Họ tên</th>
                            <th>Lớp</th>
                            <th>Hoạt động đăng ký</th>
                            <th>Xác nhận tham gia</th>
                            <th>Ghi nhận kết quả</th>
                            <th>Lưu</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% danhSachDk.forEach(dk => { %>
                            <tr>
                                <form method="POST" action="/admin/dang-ky/cap-nhat/<%= dk.id %>">
                                    <td><strong><%= dk.mssv %></strong> - <%= dk.ho_ten %></td>
                                    <td><%= dk.lop %></td>
                                    <td class="small"><%= dk.tieu_de %></td>
                                    <td>
                                        <select name="trang_thai_duyet" class="form-select form-select-sm">
                                            <option value="cho_duyet" <%= dk.trang_thai_duyet === 'cho_duyet' ? 'selected' : '' %>>Chờ duyệt</option>
                                            <option value="da_duyet" <%= dk.trang_thai_duyet === 'da_duyet' ? 'selected' : '' %>>Xác nhận tham gia</option>
                                            <option value="tu_choi" <%= dk.trang_thai_duyet === 'tu_choi' ? 'selected' : '' %>>Từ chối</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select name="ket_qua" class="form-select form-select-sm">
                                            <option value="chua_co" <%= dk.ket_qua === 'chua_co' ? 'selected' : '' %>>Chưa có</option>
                                            <option value="hoan_thanh" <%= dk.ket_qua === 'hoan_thanh' ? 'selected' : '' %>>Hoàn thành</option>
                                            <option value="vang_mat" <%= dk.ket_qua === 'vang_mat' ? 'selected' : '' %>>Vắng mặt</option>
                                        </select>
                                    </td>
                                    <td><button type="submit" class="btn btn-primary btn-sm">Lưu</button></td>
                                </form>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>