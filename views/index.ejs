<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Hoạt động Tình nguyện - Trường Kỹ thuật và Công nghệ TVU</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🎓 TÌNH NGUYỆN - TRƯỜNG KT&CN (TVU)</a>
            <div class="d-flex align-items-center gap-2">
                <% if (user) { %>
                    <% if (user.vai_tro === 'admin') { %>
                        <a href="/admin" class="btn btn-warning btn-sm fw-bold">Trang Quản Trị</a>
                    <% } else { %>
                        <a href="/lich-su" class="btn btn-outline-light btn-sm">Lịch sử tham gia</a>
                    <% } %>
                    <span class="text-white small mx-2">Chào, <strong><%= user.ho_ten %></strong> (<%= user.mssv %>)</span>
                    <a href="/logout" class="btn btn-danger btn-sm">Đăng xuất</a>
                <% } else { %>
                    <a href="/login" class="btn btn-light btn-sm fw-bold text-primary">Đăng nhập / Đăng ký</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container">
        <form method="GET" action="/" class="row g-2 bg-white p-3 rounded shadow-sm mb-4">
            <div class="col-md-6">
                <input type="text" name="q" class="form-control" placeholder="Tìm theo tên hoạt động hoặc địa điểm..." value="<%= q %>">
            </div>
            <div class="col-md-4">
                <select name="don_vi_id" class="form-select">
                    <option value="">-- Tất cả đơn vị tổ chức --</option>
                    <% donVis.forEach(dv => { %>
                        <option value="<%= dv.id %>" <%= don_vi_id == dv.id ? 'selected' : '' %>><%= dv.ten_don_vi %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
            </div>
        </form>

        <h4 class="mb-3 text-primary fw-bold">Các hoạt động tình nguyện đang triển khai</h4>
        <div class="row">
            <% hoatDongs.forEach(hd => { 
                const daDuCho = hd.da_dang_ky >= hd.so_luong_toi_da;
                const daDangKy = registeredIds.includes(hd.id);
            %>
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <span class="badge bg-info text-dark mb-2"><%= hd.ten_don_vi %></span>
                            <h5 class="card-title fw-bold text-dark"><%= hd.tieu_de %></h5>
                            <p class="card-text text-muted small"><%= hd.mo_ta %></p>
                            <ul class="list-unstyled small mb-0">
                                <li class="mb-1"><strong>🕒 Thời gian:</strong> <%= new Date(hd.thoi_gian_bat_dau).toLocaleString('vi-VN') %></li>
                                <li class="mb-1"><strong>📍 Địa điểm:</strong> <%= hd.dia_diem %></li>
                                <li class="mb-1"><strong>📋 Yêu cầu:</strong> <%= hd.yeu_cau || 'Không có' %></li>
                                <li><strong>👥 Số lượng:</strong> 
                                    <span class="badge <%= daDuCho ? 'bg-danger' : 'bg-success' %>">
                                        <%= hd.da_dang_ky %> / <%= hd.so_luong_toi_da %> sinh viên
                                    </span>
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white border-top-0 pb-3">
                            <% if (daDangKy) { %>
                                <button class="btn btn-secondary btn-sm w-100" disabled>✔ Bạn đã đăng ký hoạt động này</button>
                            <% } else if (daDuCho) { %>
                                <button class="btn btn-danger btn-sm w-100" disabled>Đã đủ số lượng đăng ký</button>
                            <% } else { %>
                                <form method="POST" action="/dang-ky/<%= hd.id %>">
                                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">Đăng ký tham gia ngay</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>
