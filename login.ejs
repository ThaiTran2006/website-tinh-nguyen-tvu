<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng nhập Hệ thống Tình nguyện TVU</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="text-center mb-4">
            <a href="/" class="text-decoration-none fw-bold fs-4 text-primary">🎓 HỆ THỐNG TÌNH NGUYỆN - TRƯỜNG KT&CN (TVU)</a>
        </div>

        <% if (error) { %><div class="alert alert-danger text-center"><%= error %></div><% } %>
        <% if (success) { %><div class="alert alert-success text-center"><%= success %></div><% } %>

        <div class="row justify-content-center g-4">
            <div class="col-md-5">
                <div class="card shadow-sm border-0 p-4">
                    <h4 class="text-primary fw-bold mb-3">Đăng nhập</h4>
                    <form method="POST" action="/login">
                        <div class="mb-3">
                            <label class="form-label">Mã số sinh viên (hoặc admin)</label>
                            <input type="text" name="mssv" class="form-control" placeholder="VD: 110124256" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu</label>
                            <input type="password" name="mat_khau" class="form-control" placeholder="******" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Đăng nhập</button>
                    </form>
                    <div class="mt-3 small text-muted bg-light p-2 rounded">
                        <strong>Tài khoản mẫu có sẵn:</strong><br>
                        • Sinh viên: <code>110124256</code> / MK: <code>123456</code><br>
                        • Ban tổ chức: <code>admin</code> / MK: <code>123456</code>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card shadow-sm border-0 p-4">
                    <h4 class="text-success fw-bold mb-3">Đăng ký tài khoản Sinh viên</h4>
                    <form method="POST" action="/register">
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small">MSSV *</label>
                                <input type="text" name="mssv" class="form-control form-control-sm" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Mã lớp *</label>
                                <input type="text" name="lop" class="form-control form-control-sm" placeholder="VD: DA24TTA" required>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Họ và tên *</label>
                            <input type="text" name="ho_ten" class="form-control form-control-sm" required>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small">Email</label>
                                <input type="email" name="email" class="form-control form-control-sm">
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Số điện thoại</label>
                                <input type="text" name="sdt" class="form-control form-control-sm">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small">Mật khẩu *</label>
                            <input type="password" name="mat_khau" class="form-control form-control-sm" required>
                        </div>
                        <button type="submit" class="btn btn-success w-100 fw-bold">Tạo tài khoản</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>